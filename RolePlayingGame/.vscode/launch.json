{
    "version": "0.2.0",
    "configurations": [
        {
             "name": "Windows",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-windows",
            "program": "${workspaceFolder}/Platforms/Windows/bin/Debug/net10.0-windows/RolePlayingGame.exe",
            "cwd": "${workspaceFolder}/Platforms/Windows"
        },
        {
            "name": "DesktopGL",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-desktop",
            "program": "${workspaceFolder}/Platforms/Desktop/bin/Debug/net10.0/RolePlayingGame",
            "cwd": "${workspaceFolder}/Platforms/Desktop"
        },
        {
            "name": "Android",
            "type": "mono",
            "request": "attach",
            "address": "localhost",
            "port": 10000,
			"preLaunchTask": "build-android",
        },
        {
            "name": "iOS",
            "type": "mono",
            "request": "attach",
            "address": "localhost",
            "port": 10001,
            "preLaunchTask": "build-ios",
        }
    ]
}