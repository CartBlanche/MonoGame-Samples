<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>ShatterEffect.DesktopGL</RootNamespace>
    <AssemblyTitle>Shatter Effect</AssemblyTitle>
    <AssemblyProduct>Shatter Effect</AssemblyProduct>
    <Description>This sample shows how you can apply an effect on any model in your game to shatter it apart. The effect is simulated with a vertex shader.</Description>
    <Company>Microsoft</Company>
    <Copyright>Copyright © Microsoft</Copyright>
    <Version>1.0.0.0</Version>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\ShatterEffect.Core.csproj" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5-preview.3" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.5-preview.3" />
  </ItemGroup>

  <ItemGroup>
    <MonoGameContentReference Include="..\..\Core\Content\Content.mgcb">
      <Link>Content\Content.mgcb</Link>
      <Platform>DesktopGL</Platform>
    </MonoGameContentReference>
  </ItemGroup>

  <Target Name="RestoreDotnetTools" BeforeTargets="CollectPackageReferences">
    <Message Text="Restoring dotnet tools..." Importance="High" />
    <Exec Command="dotnet tool restore" />
  </Target>
</Project>
