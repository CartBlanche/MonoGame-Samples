<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>CatapultGame</RootNamespace>
    <AssemblyName>CatapultNetWars</AssemblyName>
    <AndroidApplication>true</AndroidApplication>
    <AndroidResgenFile>Resources\Resource.designer.cs</AndroidResgenFile>
    <AndroidResgenClass>Resource</AndroidResgenClass>
    <MonoAndroidResourcePrefix>Resources</MonoAndroidResourcePrefix>
    <MonoAndroidAssetsPrefix>Assets</MonoAndroidAssetsPrefix>
    <AndroidUseLatestPlatformSdk>false</AndroidUseLatestPlatformSdk>
    <AndroidTargetSdkVersion>33</AndroidTargetSdkVersion>
    <AndroidMinSdkVersion>21</AndroidMinSdkVersion>
    <MonoGamePlatform>Android</MonoGamePlatform>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\CatapultNetWars.Core.csproj" />
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.*" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
  </ItemGroup>

  <ItemGroup>
    <MonoGameContentReference Include="..\..\Core\Content\Content.mgcb" />
  </ItemGroup>

  <!-- Centralized icons, generated by Icons/generate-all-icons.sh -->
  <ItemGroup>
    <AndroidResource Include="..\..\Icons\Android\mipmap-mdpi\ic_launcher.png">
      <Link>Resources\mipmap-mdpi\ic_launcher.png</Link>
    </AndroidResource>
    <AndroidResource Include="..\..\Icons\Android\mipmap-hdpi\ic_launcher.png">
      <Link>Resources\mipmap-hdpi\ic_launcher.png</Link>
    </AndroidResource>
    <AndroidResource Include="..\..\Icons\Android\mipmap-xhdpi\ic_launcher.png">
      <Link>Resources\mipmap-xhdpi\ic_launcher.png</Link>
    </AndroidResource>
    <AndroidResource Include="..\..\Icons\Android\mipmap-xxhdpi\ic_launcher.png">
      <Link>Resources\mipmap-xxhdpi\ic_launcher.png</Link>
    </AndroidResource>
    <AndroidResource Include="..\..\Icons\Android\mipmap-xxxhdpi\ic_launcher.png">
      <Link>Resources\mipmap-xxxhdpi\ic_launcher.png</Link>
    </AndroidResource>
    <AndroidResource Include="..\..\Icons\Android\drawable\icon.png">
      <Link>Resources\drawable\icon.png</Link>
    </AndroidResource>
  </ItemGroup>

</Project>
