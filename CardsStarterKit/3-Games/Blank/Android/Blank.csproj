<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Blank.Android</RootNamespace>
    <AssemblyName>Blank</AssemblyName>
    <AssemblyTitle>Blank</AssemblyTitle>
    <Description>Android platform for Blank Game.</Description>
    <Authors>CartBlanche</Authors>
    <Company>MonoGame Foundation</Company>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AndroidApplication>True</AndroidApplication>
    <SupportedOSPlatformVersion>28.0</SupportedOSPlatformVersion>
    <ApplicationId>com.cartblanche.blank</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Blank.Core.csproj" />
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.*" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
  </ItemGroup>

  <ItemGroup>
    <MonoGameContentReference Include="..\Content\Content.mgcb" />
  </ItemGroup>

  <!-- Centralized Icon Resources -->
  <ItemGroup>
    <!-- Mipmap launcher icons -->
    <AndroidResource Include="..\..\..\2-Core\Resources\Icons\Android\mipmap-mdpi\ic_launcher.png">
      <Link>Resources\mipmap-mdpi\ic_launcher.png</Link>
    </AndroidResource>
    <AndroidResource Include="..\..\..\2-Core\Resources\Icons\Android\mipmap-hdpi\ic_launcher.png">
      <Link>Resources\mipmap-hdpi\ic_launcher.png</Link>
    </AndroidResource>
    <AndroidResource Include="..\..\..\2-Core\Resources\Icons\Android\mipmap-xhdpi\ic_launcher.png">
      <Link>Resources\mipmap-xhdpi\ic_launcher.png</Link>
    </AndroidResource>
    <AndroidResource Include="..\..\..\2-Core\Resources\Icons\Android\mipmap-xxhdpi\ic_launcher.png">
      <Link>Resources\mipmap-xxhdpi\ic_launcher.png</Link>
    </AndroidResource>
    <AndroidResource Include="..\..\..\2-Core\Resources\Icons\Android\mipmap-xxxhdpi\ic_launcher.png">
      <Link>Resources\mipmap-xxxhdpi\ic_launcher.png</Link>
    </AndroidResource>

    <!-- Drawable icon for splash screen -->
    <AndroidResource Include="..\..\..\2-Core\Resources\Icons\Android\drawable\icon.png">
      <Link>Resources\drawable\icon.png</Link>
    </AndroidResource>
  </ItemGroup>

</Project>