+        // RACINGGAME_CAM=front | 34 : view the car from in front (rig only)
+        static readonly string cam = E("RACINGGAME_CAM");
+        public static void CamHook()
+        {
+            if (cam == null || !started) return;
+            var p = RacingGameManager.Player;
+            Microsoft.Xna.Framework.Vector3 pos = p.LookAtPos, fwd = p.CarDirection, up = p.CarUpVector;
+            Microsoft.Xna.Framework.Vector3 right = Microsoft.Xna.Framework.Vector3.Cross(fwd, up);
+            Microsoft.Xna.Framework.Vector3 eye = cam == "front" ? pos + fwd * 9.0f + up * 1.3f
+                : pos + fwd * 6.5f + right * 4.5f + up * 1.6f;
+            BaseGame.ViewMatrix = Microsoft.Xna.Framework.Matrix.CreateLookAt(eye, pos + up * 0.7f, up);
+        }
+
         public static void UpdateHook()
         {
             if (started) { updates++; DumpTunnels(); Teleport(); }
