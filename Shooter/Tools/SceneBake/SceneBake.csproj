<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SceneBake</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- Shared with the runtime so the Unity -> MonoGame conversion exists exactly once. -->
    <Compile Include="..\..\Core\Scene\UnityConvert.cs" Link="Shared\UnityConvert.cs" />
    <Compile Include="..\..\Core\Scene\SceneFile.cs" Link="Shared\SceneFile.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Only Matrix/Quaternion/Vector math is used; no GraphicsDevice. -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
  </ItemGroup>
</Project>
