<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The mgcb tool pinned in .config/dotnet-tools.json (3.8.5) runs on .NET 8 and can only load extensions built
         for net8.0 against exactly MonoGame.Framework.Content.Pipeline 3.8.5. Keep these in sync with that manifest. -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Shooter.Pipeline</RootNamespace>
    <AssemblyName>Shooter.Pipeline</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Fixed output location so the .mgcb /reference path does not depend on Debug/Release. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Content.Pipeline" Version="3.8.5" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5" PrivateAssets="All" />
  </ItemGroup>
</Project>
