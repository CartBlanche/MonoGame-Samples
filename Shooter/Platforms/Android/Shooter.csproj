<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Shooter.Android</RootNamespace>
    <AssemblyName>Shooter</AssemblyName>
    <AssemblyTitle>Shooter</AssemblyTitle>
    <AssemblyDescription>MonoGame Port of Unity's Shooter to Android</AssemblyDescription>
    <AssemblyCompany>MonoGame Samples</AssemblyCompany>
    <AssemblyProduct>Shooter</AssemblyProduct>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <AndroidApplication>true</AndroidApplication>
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <MonoGamePlatform>Android</MonoGamePlatform>
    <SupportedOSPlatformVersion>28</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Shooter.Core.csproj" />
    <ProjectReference Include="..\..\Physics\Shooter.Physics.csproj" />
    <ProjectReference Include="..\..\Graphics\Shooter.Graphics.csproj" />
    <ProjectReference Include="..\..\Gameplay\Shooter.Gameplay.csproj" />
    <ProjectReference Include="..\..\UI\Shooter.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.*" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
  </ItemGroup>

  <ItemGroup>
    <MonoGameContentReference Include="..\..\Core\Content\Content.mgcb" />
  </ItemGroup>

</Project>
