<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Splash for API 28-30: the background colour with the icon centred (Android 12+ uses the native splash in values-v31) -->
    <item android:drawable="@color/background_dark" />
    <item>
        <bitmap android:src="@drawable/icon" android:gravity="center" />
    </item>
</layer-list>
