<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Shooter.iOS</RootNamespace>
    <AssemblyName>Shooter</AssemblyName>
    <AssemblyTitle>Shooter - iOS</AssemblyTitle>
    <AssemblyDescription>MonoGame Port of Unity's Shooter to iOS</AssemblyDescription>
    <AssemblyCompany>MonoGame Samples</AssemblyCompany>
    <AssemblyProduct>Shooter</AssemblyProduct>
    <AssemblyCopyright>MonoGame Foundation</AssemblyCopyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <UseInterpreter>true</UseInterpreter>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <MonoGamePlatform>iOS</MonoGamePlatform>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shooter.Core\Shooter.Core.csproj" />
    <ProjectReference Include="..\..\Shooter.Physics\Shooter.Physics.csproj" />
    <ProjectReference Include="..\..\Shooter.Graphics\Shooter.Graphics.csproj" />
    <ProjectReference Include="..\..\Shooter.Gameplay\Shooter.Gameplay.csproj" />
    <ProjectReference Include="..\..\Shooter.UI\Shooter.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.iOS" Version="3.8.*" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
  </ItemGroup>

  <!-- Content pipeline disabled until Phase 1 - no assets yet -->
  <!-- <ItemGroup>
    <MonoGameContentReference Include="Content\Content.mgcb" />
  </ItemGroup> -->

</Project>